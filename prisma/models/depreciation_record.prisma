model DepreciationRecord {
  id Int @id @default(autoincrement())

  fixedAssetId Int
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id])

  processDate DateTime

  depreciatedAmount Decimal @db.Decimal(18,2)

  accumulatedDepreciation Decimal @db.Decimal(18,2)

  journalEntryNumberId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
}